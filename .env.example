# Database configuration
# Local development can use a file-backed libsql database.
SQLITE_DB_PATH=./data/ignite26.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
API_BODY_LIMIT=25mb
PUBLIC_SITE_URL=https://ignite26.teamparadox.in

# Super Admin configuration (Sole source of truth for super admin rights)
# Exactly two super admins, comma-separated, trimmed, case-insensitive.
# If missing or empty, server fails closed: nobody gets super admin rights.
# No UI or API can create, promote, or demote super admins.
SUPER_ADMIN_EMAILS=j74117204@gmail.com,pragatiie0601@gmail.com
LOGIN_APPROVAL_EXPIRY_MINUTES=10

# Admin login credentials (loaded by API server on startup)
# Add each allowlisted email with its own unique password (minimum 12 characters).
ADMIN_CREDENTIALS_JSON=

# Public event social links (used in website footer)
VITE_EVENT_WHATSAPP_URL=https://chat.whatsapp.com/DWG8csYKaY42HQQyMNqBza?s=sw&p=a&mlu=4&ilr=4&iam=2
VITE_EVENT_INSTAGRAM_URL=https://www.instagram.com/theignite2.0/?hl=en

# SMTP configuration (used for OTP + registration confirmation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Ignite 2.O <your-email@example.com>

# Google Sheet sync (optional)
# Accepts normal Google Sheet URL or direct CSV export URL.
GOOGLE_SHEET_SYNC_URL=
# Shared secret for webhook-based push sync from Google Apps Script.
SHEET_SYNC_SECRET=

# Hidden validation handler page default password (can be rotated from admin dashboard)
VALIDATION_HANDLER_PASSWORD=ignite-handler-26

# Vercel Blob storage (required for media uploads on Vercel)
BLOB_READ_WRITE_TOKEN=

