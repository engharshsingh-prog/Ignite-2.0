{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "functions":  {
                      "api/index.js":  {
                                           "maxDuration":  10
                                       }
                  },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api?path=:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
