{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "functions":  {
                      "api/index.js":  {
                                           "maxDuration":  10
                                       }
                  },
    "routes":  [
                   {
                       "src":  "/api/(.*)",
                       "dest":  "/api?path=$1"
                   },
                   {
                       "handle":  "filesystem"
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/index.html"
                   }
               ]
}
