# Server
PORT=8787
API_BODY_LIMIT=25mb
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Database: local SQLite file for development, or configure both Turso values in production.
SQLITE_DB_PATH=./data/ignite26.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Authentication. Use real values only in the backend host's secret settings.
SUPER_ADMIN_EMAILS=
ADMIN_CREDENTIALS_JSON={}
LOGIN_APPROVAL_EXPIRY_MINUTES=10
VALIDATION_HANDLER_PASSWORD=

# SMTP for OTP and registration emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional integrations
GOOGLE_SHEET_SYNC_URL=
SHEET_SYNC_SECRET=
BLOB_READ_WRITE_TOKEN=
